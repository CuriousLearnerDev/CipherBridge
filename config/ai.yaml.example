# 复制为 ai.yaml 后填入你的 API Key（ai.yaml 已在 .gitignore 中，不会提交）
api_key: "your-api-key-here"
# deepseek | newapi | custom
api_format: deepseek
base_url: https://api.deepseek.com/v1
# api_format=custom 时填写；其它格式可留空（自动推导）
agent_base_url: ""
agent_max_steps: 50
browser:
  headless: false
  # 默认只开密钥 Hook；反调试 / CDP / 响应改写按需勾选
  hook_enabled: true
  anti_debug: false
  cdp_skip_pauses: false
  # 默认加载油猴(Violentmonkey) + ReRes；首次启动用 ext_proxy 拉 GitHub
  load_violentmonkey: true
  load_reres: true
  load_cb_hook: true
  ext_proxy: 127.0.0.1:7897
  # 记录模式：固定 data/browser_profile 长期复用（类似 Burp）；false=临时会话
  record_mode: true
  # chromium=Playwright 内置；chrome=本机 Google Chrome
  browser_channel: chromium
  mitm_port: 8080
  use_mitm_proxy: false
http_proxy: 127.0.0.1:7897
model: deepseek-chat
provider: deepseek
use_http_proxy: false
